# Copia este archivo a .env:   cp .env.example .env
# Todo es opcional: si no existe .env, docker compose usa estos mismos valores por defecto.
# Evita $, # y comillas en las contraseñas.

# ---- MySQL ----
# En un servidor público CAMBIA las dos contraseñas antes del primer arranque.
# (Si ya levantaste la base, cambiarlas aquí no actualiza el volumen existente: ver DOCKER.md)
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_USER=astro
MYSQL_PASSWORD=astro_change_me
MYSQL_DATABASE=astro
# Puerto local para conectarte con un cliente MySQL (solo 127.0.0.1)
MYSQL_HOST_PORT=3307

# ---- App ----
APP_PORT=3010
# Local: 0.0.0.0. En web con Caddy: 127.0.0.1
APP_BIND=0.0.0.0
# Orígenes permitidos para la API, separados por coma. En web: https://astro.midominio.com
CORS_ORIGIN=*

# ---- Web (solo con: docker compose --profile web up -d --build) ----
DOMAIN=localhost

# ---- Python / fuentes de datos ----
# Tabla del servicio Gaia DR3 TAP de MAST (según sus ejemplos oficiales): dbo.gaia_source.
# El código convierte automáticamente gaiadr3.gaia_source (configuración antigua) a dbo.gaia_source.
MAST_GAIA_TABLE=dbo.gaia_source
WISE_TABLE=allwise_p3as_psd

# Timeout máximo del proxy para consultas remotas (ms).
UPSTREAM_TIMEOUT_MS=40000

# Solo si tu red requiere proxy para salir a internet (descomenta y configura).
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1,mysql,node,python
