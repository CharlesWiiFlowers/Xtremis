# %ECSV 1.0
# ---
# delimiter: ','
# meta: !!omap
# - RELEASE: Gaia DR3
# - TABLE: mcmc_samples_msc
# - DESCRIPTION: >
#     This is the DataLink table hosting Monte-Carlo Markov Chain (MCMC) samples for the posterior probability distribution of all parameters derived from the Multiple Source Classifier (MSC, see Section~\ref{ssec:cu8par_apsis_msc} in the online documentation). 100 random MCMC samples are provided for each source.
#     
#     The table considers the following parameters:
#     
#     \begin{itemize}
#     \item effective temperature $T_{\rm eff, 1}$ of the primary star
#     \item effective temperature $T_{\rm eff, 2}$ of the secondary star
#     \item surface gravity $\log g_1$ of the primary star
#     \item surface gravity $\log g_2$ of the secondary star
#     \item monochromatic extinction at 547.7~nm $A_0$
#     \item metallicity [M/H]
#     \item distance
#     \item logarithmic posterior probability
#     \item logarithmic likelihood
#     \end{itemize}
#     
#     
#     Note this table is not available through the main archive TAP interface. Data are delivered via the Massive Data service indexed by the VO Datalink protocol and described in Chapter~\ref{chap:archive}. For example this can be actioned in the archive user interface by querying the main source catalogue {\tt GaiaSource} and selecting {\tt hasMcmcMsc}~{\tt = 't'}.
# - CITATION: >
#     How to cite and acknowledge Gaia: 
#     https://gea.esac.esa.int/archive/documentation/credits.html 
# - KNOWN_ISSUES: >
#     Known issues: 
#     https://www.cosmos.esa.int/web/gaia-users/known-issues 
# - DOCUMENTATION: >
#     Tutorials and documentation: 
#     https://www.cosmos.esa.int/web/gaia-users/archive 
# datatype:
# - 
#   name: source_id
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release)
#   meta:
#     ucd: meta.id
# - 
#   name: solution_id
#   datatype: int64
#   description: Solution Identifier
#   meta:
#     ucd: meta.version
# - 
#   name: nsamples
#   datatype: int16
#   description: Number of samples in the chain from MSC
#   meta:
#     ucd: meta.number
# - 
#   name: teff1
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: K
#   description: "MCMC samples for $T_{\\rm eff, 1}$ of primary from MSC"
#   meta:
#     ucd: phys.temperature.effective
# - 
#   name: teff2
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: K
#   description: "MCMC samples for $T_{\\rm eff, 2}$ of secondary from MSC"
#   meta:
#     ucd: phys.temperature.effective
# - 
#   name: logg1
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: log(cm.s**-2)
#   description: MCMC samples for $\\log g_1$ of primary from MSC
#   meta:
#     ucd: phys.gravity
# - 
#   name: logg2
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: log(cm.s**-2)
#   description: MCMC samples for $\\log g_2$ of secondary from MSC
#   meta:
#     ucd: phys.gravity
# - 
#   name: azero
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: MCMC samples for extinction $A_0$ from MSC
#   meta:
#     ucd: phys.absorption;em.opt
# - 
#   name: mh
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: "'dex'"
#   description: MCMC samples for the metallicity from MSC
#   meta:
#     ucd: phys.abund.Fe
# - 
#   name: distancepc
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: pc
#   description: MCMC samples for distance from MSC
#   meta:
#     ucd: pos.distance
# - 
#   name: log_pos
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: MCMC samples for the log-posterior from MSC
#   meta:
#     ucd: stat.probability
# - 
#   name: log_lik
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: MCMC samples for the log-likelihood from MSC
#   meta:
#     ucd: stat.likelihood
source_id,solution_id,nsamples,teff1,teff2,logg1,logg2,azero,mh,distancepc,log_pos,log_lik
