# %ECSV 1.0
# ---
# delimiter: ','
# meta: !!omap
# - RELEASE: Gaia DR3
# - TABLE: rvs_mean_spectrum
# - DESCRIPTION: >
#     This is the RVS mean sampled spectrum table. The spectra are in the rest frame, they are normalised and their wavelength grid ranges from 846 to 870 nm in steps of 0.01 nm (2401 elements). 
#     
#     See~~\secref{sssec:cu6spe_meanspe} for a description on how the mean spectra are obtained, and \citet{DR3-DPACP-154} for a description of the spectra validation.
#     
#     Note this table is not available through the main archive TAP interface, but via the Massive Data service, indexed by the VO Datalink protocol, described in 
#     Chapter~\ref{chap:archive}. For example this can be actioned in the archive user interface by querying the main source catalogue {\tt GaiaSource} and selecting {\tt hasRvs}~{\tt = 't'}.
#     
#     The following columns are available in table format only if the `RAW' option is selected in the Datalink pop-up window. If the `INDIVIDUAL' or `COMBINED' options are chosen, all columns other than {\tt flux} and {\tt fluxError} are provided in the header of the xml file, while wavelength, {\tt flux} and {\tt fluxError} columns are provided in table format.
# - CITATION: >
#     How to cite and acknowledge Gaia: 
#     https://gea.esac.esa.int/archive/documentation/credits.html 
# - KNOWN_ISSUES: >
#     Known issues: 
#     https://www.cosmos.esa.int/web/gaia-users/known-issues 
# - DOCUMENTATION: >
#     Tutorials and documentation: 
#     https://www.cosmos.esa.int/web/gaia-users/archive 
# datatype:
# - 
#   name: source_id
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release)
#   meta:
#     ucd: meta.id;meta.main
# - 
#   name: solution_id
#   datatype: int64
#   description: Solution Identifier
#   meta:
#     ucd: meta.version
# - 
#   name: ra
#   datatype: float64
#   unit: deg
#   description: Right Ascension
#   meta:
#     ucd: pos.eq.ra;meta.main
# - 
#   name: dec
#   datatype: float64
#   unit: deg
#   description: Declination
#   meta:
#     ucd: pos.eq.dec;meta.main
# - 
#   name: flux
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: array of fluxes
#   meta:
#     ucd: phot.flux;em.opt.I
# - 
#   name: flux_error
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: array of uncertainties in flux
#   meta:
#     ucd: stat.error;phot.flux;em.opt.I
# - 
#   name: combined_transits
#   datatype: int16
#   description: number of combined transits
#   meta:
#     ucd: meta.number
# - 
#   name: combined_ccds
#   datatype: int16
#   description: number of combined CCD spectra
#   meta:
#     ucd: meta.number
# - 
#   name: deblended_ccds
#   datatype: int16
#   description: number of deblended CCD spectra
#   meta:
#     ucd: meta.number
