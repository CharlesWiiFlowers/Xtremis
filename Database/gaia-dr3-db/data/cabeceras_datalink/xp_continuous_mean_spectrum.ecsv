#   description: Number of rejected measurements in the BP spectrum generation
#   meta:
#     ucd: meta.number
# - 
#   name: bp_standard_deviation
#   datatype: float32
#   description: Standard deviation for the BP spectrum representation
#   meta:
#     ucd: stat.stdev
# - 
#   name: bp_chi_squared
#   datatype: float32
#   description: Chi squared for the BP spectrum representation
#   meta:
#     ucd: stat.fit.chi2
