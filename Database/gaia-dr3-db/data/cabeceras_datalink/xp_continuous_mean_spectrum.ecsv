#   name: bp_coefficients
#   datatype: string 
#   subtype: 'float64[null]' 
#   description: Basis function coefficients for the BP spectrum representation
#   meta:
#     ucd: stat.fit.param
# - 
#   name: bp_coefficient_errors
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: Basis function coefficient errors for the BP spectrum representation
#   meta:
#     ucd: stat.error
# - 
#   name: bp_coefficient_correlations
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: Correlation matrix for BP coefficients
#   meta:
#     ucd: stat.correlation
# - 
#   name: bp_n_relevant_bases
#   datatype: int16
#   description: Number of bases that are relevant for the representation of this mean BP spectrum
#   meta:
#     ucd: meta.number
# - 
#   name: bp_relative_shrinking
#   datatype: float32
#   description: Measure of the relative shrinking of the coefficient vector when truncation is applied for the mean BP spectrum
#   meta:
#     ucd: stat.fit.param
# - 
