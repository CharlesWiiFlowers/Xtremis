#   name: solution_id
#   datatype: int64
#   description: Solution Identifier
#   meta:
#     ucd: meta.version
# - 
#   name: bp_basis_function_id
#   datatype: int16
#   description: Identifier defining the set of basis functions for the BP spectrum representation
#   meta:
#     ucd: meta.id
# - 
#   name: bp_degrees_of_freedom
#   datatype: int16
#   description: Degrees of freedom for the BP spectrum representation
#   meta:
