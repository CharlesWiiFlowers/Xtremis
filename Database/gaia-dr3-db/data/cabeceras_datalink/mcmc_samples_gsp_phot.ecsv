# %ECSV 1.0
# ---
# delimiter: ','
# meta: !!omap
# - RELEASE: Gaia DR3
# - TABLE: mcmc_samples_gsp_phot
# - DESCRIPTION: >
#     This is the DataLink table hosting Monte-Carlo Markov Chain (MCMC) samples for the posterior probability distribution of all parameters derived from the General Stellar Parametrizer from Photometry (GSP-Phot, see Section~\ref{ssec:cu8par_apsis_gspphot} in the online documentation). 2000 MCMC samples are provided for 1) all sources brighter than G=12, 2) a random subset of 0.1\% of the sources fainter than G=12. For all other sources fainter than G=12, the sample size is 100 (the last 100 samples in the MCMC).
#     
#     The table considers the following parameters:
#     
#     \begin{itemize}
#     \item effective temperature $T_{\rm eff}$ in K
#     \item monochromatic extinction at 547.7~nm $A_0$ in mag
#     \item surface gravity $\log g$
#     \item metallicity [M/H]
#     \item $G$-band extinction in mag
#     \item absolute magnitude $M_{\rm G}$ in mag
#     \item distance in pc
#     \item $G_{\rm BP}$ band extinction $A_{\rm BP}$ in mag
#     \item $G_{\rm RP}$ band extinction $A_{\rm RP}$ in mag
#     \item reddening $E(G_{\rm BP} - G_{\rm RP}) = A_{\rm BP} - A_{\rm RP}$ in mag
#     \item logarithmic posterior probability
#     \item logarithmic likelihood
#     \item stellar radius in $R_\odot$
#     \end{itemize}
#     
#     Note this table is not available through the main archive TAP interface. Data are delivered via the Massive Data service indexed by the VO Datalink protocol and described in Chapter~\ref{chap:archive}. For example this can be actioned in the archive user interface by querying the main source catalogue {\tt GaiaSource} and selecting {\tt hasMcmcGspphot}~{\tt = 't'}.
# - CITATION: >
#     How to cite and acknowledge Gaia: 
#     https://gea.esac.esa.int/archive/documentation/credits.html 
# - KNOWN_ISSUES: >
#     Known issues: 
#     https://www.cosmos.esa.int/web/gaia-users/known-issues 
# - DOCUMENTATION: >
#     Tutorials and documentation: 
#     https://www.cosmos.esa.int/web/gaia-users/archive 
# datatype:
# - 
#   name: solution_id
#   datatype: int64
#   description: Solution Identifier
#   meta:
#     ucd: meta.version
# - 
#   name: source_id
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release)
#   meta:
#     ucd: meta.id
# - 
#   name: nsamples
#   datatype: int16
#   description: Number of samples in the chain from GSP-Phot
#   meta:
#     ucd: meta.number
# - 
#   name: teff
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: K
#   description: "MCMC samples for $T_{\\rm eff}$ from GSP-Phot"
#   meta:
#     ucd: phys.temperature.effective
# - 
#   name: azero
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: MCMC samples for extinction $A_0$ from GSP-Phot
#   meta:
#     ucd: phys.absorption;em.opt
# - 
#   name: logg
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: log(cm.s**-2)
#   description: MCMC samples for $\\log g$ from GSP-Phot
#   meta:
#     ucd: phys.gravity
# - 
#   name: mh
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: "'dex'"
#   description: MCMC samples for the metallicity from GSP-Phot
#   meta:
#     ucd: phys.abund
# - 
#   name: ag
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: MCMC samples for extinction in G band from GSP-Phot
#   meta:
#     ucd: phys.absorption;em.opt
# - 
#   name: mg
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: "MCMC samples for $M_{\\rm G}$ from GSP-Phot"
#   meta:
#     ucd: phys.magAbs;em.opt
# - 
#   name: distancepc
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: pc
#   description: MCMC samples for distance from GSP-Phot
#   meta:
#     ucd: pos.distance
# - 
#   name: abp
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: "MCMC samples for extinction in $G_{\\rm BP}$ band from GSP-Phot"
#   meta:
#     ucd: phys.absorption;em.opt.B
# - 
#   name: arp
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: "MCMC samples for extinction in $G_{\\rm RP}$ band from GSP-Phot"
#   meta:
#     ucd: phys.absorption;em.opt.R
# - 
#   name: ebpminrp
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: mag
#   description: "MCMC samples for reddening $E(G_{\\rm BP} - G_{\\rm RP})$ from GSP-Phot"
#   meta:
#     ucd: phot.color.excess;em.opt
# - 
#   name: log_pos
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: MCMC samples for the log-posterior from GSP-Phot
#   meta:
#     ucd: stat.probability
# - 
#   name: log_lik
#   datatype: string 
#   subtype: 'float32[null]' 
#   description: MCMC samples for the log-likelihood from GSP-Phot
#   meta:
#     ucd: stat.likelihood
# - 
#   name: radius
#   datatype: string 
#   subtype: 'float32[null]' 
#   unit: solRad
#   description: MCMC samples for stellar radius from GSP-Phot
#   meta:
#     ucd: phys.size.radius
solution_id,source_id,nsamples,teff,azero,logg,mh,ag,mg,distancepc,abp,arp,ebpminrp,log_pos,log_lik,radius
