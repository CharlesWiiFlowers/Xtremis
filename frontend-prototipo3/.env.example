# Copia este archivo como .env.local y ajusta los valores.

# true  = usa datos simulados (no necesita backend)
# false = usa el backend real
VITE_USE_MOCK=true

# URL del backend. Vacío = mismo origen (en dev, Vite redirige /api a localhost:8000)
VITE_API_URL=

# (Opcional) URL del modelo 3D del equipo. Si se define, aparece la pestaña "Modelo 3D"
# y ambos visores se sincronizan por mensajes. Ver INTEGRACION_MODELO.md
VITE_MODEL_URL=
